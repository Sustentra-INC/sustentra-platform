{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustentra.local/contracts/processing_run.schema.json",
  "title": "ProcessingRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "document_id",
    "engagement_id",
    "status",
    "started_at",
    "completed_at",
    "pipeline_version",
    "error"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "in_progress",
        "completed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "description": "When the document was first picked up; null while the run is still queued.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "description": "Email of the user who asked for the document to be read.",
      "type": "string"
    },
    "attempt": {
      "description": "How many times reading has started (a retry after a problem on our side counts again).",
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "canonical_type_id_override": {
      "description": "The document type the user chose, when the run reads the document as that type.",
      "type": [
        "string",
        "null"
      ]
    },
    "pipeline_run_id": {
      "description": "The pipeline run the read recorded (set once the run is completed).",
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "description": "Why a failed run failed, e.g. unreadable_document, file_missing, worker_error, timed_out.",
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "description": "The message shown to the user when the run failed.",
      "type": [
        "string",
        "null"
      ]
    }
  }
}
