<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sustentra sign-in code</title>
  </head>
  <body style="margin:0;padding:0;background:#f5f7fb;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fb;padding:16px 8px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;">
            <tr>
              <td style="padding:20px;line-height:1.5;font-size:15px;word-break:break-word;overflow-wrap:anywhere;">
                <p style="margin:0 0 12px 0;">Hello,</p>
                <p style="margin:0 0 12px 0;">Your Sustentra sign-in code is:</p>
                <p style="margin:0 0 12px 0;font-size:28px;font-weight:700;letter-spacing:0.12em;">{{ code }}</p>
                <p style="margin:0 0 12px 0;">This code expires in {{ expires_minutes }} minutes.</p>
                <p style="margin:0 0 12px 0;">If you did not request this sign-in code, you can ignore this email. Your password is still required to use this code.</p>
                <p style="margin:20px 0 0 0;">- {{ sender_name }}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
