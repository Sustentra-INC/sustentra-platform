BACKEND_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
AWS_REGION=us-east-1
S3_BUCKET=replace-me
OPENAI_API_KEY=replace-me
RAG_API_URL=replace-me
RAG_API_KEY=replace-me

# Parser runtime (PR4). Local parsing needs no credentials; tests never read these.
LOCAL_PARSER_ENABLED=true
TEXTRACT_ENABLED=false
TEXTRACT_REGION=us-east-1
TEXTRACT_FEATURE_TYPES=FORMS,TABLES
TEXTRACT_OUTPUT_BUCKET=replace-me
AWS_PROFILE=replace-me

# Identity currently uses local JSONL (no database required).
# First Sustentra user is created via POST /v1/users or the /login page.

# API settings (AUTH-001). Local values; prod values come from SSM via deploy.sh.
ENVIRONMENT=local
GIT_SHA=dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://app_user:local-app-password@localhost:5433/sustentra
OTP_HMAC_SECRET=local-otp-hmac-secret-not-for-prod
SMTP_HOST=localhost
SMTP_PORT=1025
