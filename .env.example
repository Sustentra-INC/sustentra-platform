BACKEND_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_S1_DATA_MODE=backend

# Local default:
SUSTENTRA_PERSISTENCE_BACKEND=jsonl
SUSTENTRA_STORAGE_BACKEND=local
SUSTENTRA_LOCAL_UPLOAD_ROOT=local-data/uploads

# Shared staging:
DATABASE_URL=postgresql+psycopg2://sustentra:sustentra@localhost:5432/sustentra
SUSTENTRA_PERSISTENCE_BACKEND=postgres
SUSTENTRA_STORAGE_BACKEND=minio
SUSTENTRA_S3_ENDPOINT_URL=http://localhost:9000
SUSTENTRA_S3_ACCESS_KEY_ID=sustentra
SUSTENTRA_S3_SECRET_ACCESS_KEY=sustentra-password
SUSTENTRA_S3_BUCKET=sustentra-documents
SUSTENTRA_S3_REGION=us-east-1
SUSTENTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AWS_REGION=us-east-1
S3_BUCKET=replace-me
OPENAI_API_KEY=replace-me
SUSTENTRA_LLM_EXTRACTION_ENABLED=false
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
RAG_API_URL=replace-me
RAG_API_KEY=replace-me

# Parser runtime (PR4). Local parsing needs no credentials; tests never read these.
LOCAL_PARSER_ENABLED=true
TEXTRACT_ENABLED=false
TEXTRACT_REGION=us-east-1
TEXTRACT_FEATURE_TYPES=FORMS,TABLES
TEXTRACT_OUTPUT_BUCKET=replace-me
AWS_PROFILE=replace-me
