# Environment for a hosted intake pilot. Copy the values into your host's
# settings screen - this file is a reference, not something to deploy.
#
# Every one of these overrides a value in intake/config/intake_settings.json.
# Anything you leave unset keeps the file's default, which is safe for local
# work and wrong for a public deployment - see the notes.
#
# NEVER commit real values. This file holds placeholders only.

# ---------------------------------------------------------------------------
# On the API host (Railway, Render, Fly - anywhere that runs a container)
# ---------------------------------------------------------------------------

# Where answers are stored. MUST point at a persistent disk, or every restart
# wipes the pilot. The Dockerfile defaults it to /data.
INTAKE_DATA_DIR=/data

# Required to create a client company. Unset means that endpoint refuses
# outright, which is the safe default - so set it, and keep it secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_ADMIN_API_KEY=replace-me

# The browser blocks every request from an origin not listed here. Put your
# Vercel address, with no trailing slash. Never "*".
INTAKE_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Where sign-in links point. Wrong value = links that 404, or that send your
# client to localhost. Keep the {token} placeholder exactly as it is.
INTAKE_VERIFY_URL_TEMPLATE=https://your-app.vercel.app/intake/login/verify?token={token}

# Where escalation emails link the team. Keep {escalation_id} as it is.
INTAKE_REVIEW_URL_TEMPLATE=https://your-app.vercel.app/intake/review/{escalation_id}

# -- email ------------------------------------------------------------------
# Default is 'outbox', which writes messages to a file and sends nothing. That
# is correct locally and useless in a pilot: nobody can sign in. Switch to smtp.
INTAKE_EMAIL_ADAPTER=smtp
INTAKE_EMAIL_FROM=no-reply@yourdomain.com
INTAKE_SMTP_HOST=smtp.gmail.com
INTAKE_SMTP_PORT=587

# Credentials come from the environment only, never from a config file.
# For Gmail this is an App Password, not your account password.
INTAKE_SMTP_USERNAME=replace-me
INTAKE_SMTP_PASSWORD=replace-me

# Only if you stay on the outbox adapter: the outbox path is NOT redirected by
# INTAKE_DATA_DIR, so point it at the disk yourself or it vanishes on restart.
# INTAKE_EMAIL_OUTBOX_PATH=/data/outbox.jsonl

# -- optional ---------------------------------------------------------------
# Who escalations go to. Defaults to the two contacts in the settings file.
# INTAKE_ESCALATION_PRIMARY=vivian@sustentra.com
# INTAKE_ESCALATION_SECONDARY=claire@sustentra.com
# INTAKE_SLA_HOURS=24
# INTAKE_REMINDER_HOURS=12

# The AI that reads typed answers. Off unless set; the interview works without
# it by routing anything it cannot parse to a human.
# INTAKE_LLM_ADAPTER=openai
# OPENAI_API_KEY=replace-me

# ---------------------------------------------------------------------------
# On Vercel (the screens)
# ---------------------------------------------------------------------------

# The address of the API host above. No trailing slash. Without this the
# screens quietly call localhost and every page fails to load anything.
NEXT_PUBLIC_BACKEND_API_URL=https://your-api.up.railway.app
