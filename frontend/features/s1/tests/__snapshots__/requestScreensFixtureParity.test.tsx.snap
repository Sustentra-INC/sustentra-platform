exports[`request screens: fixture parity > draws the Add to requests window for a workspace document as it always has 1`] = `
<div>
  <div
    class="s1-modal-scrim"
    role="presentation"
  >
    <div
      aria-labelledby="s1-atr-title"
      aria-modal="true"
      class="s1-modal s1-atr"
      role="dialog"
    >
      <div
        class="s1-atr__head"
      >
        <h2
          class="s1-atr__title"
          id="s1-atr-title"
        >
          Add to requests
        </h2>
        <button
          aria-label="Close"
          class="s1-atr__close"
          type="button"
        >
          ×
        </button>
      </div>
      <dl
        class="s1-atr__about"
        title="kent_gas_sep_2025.pdf · Kent Cannery · Sep 2025 · Uploaded"
      >
        <div
          class="s1-atr__fact"
        >
          <dt>
            Item
          </dt>
          <dd>
            kent_gas_sep_2025.pdf
          </dd>
        </div>
        <div
          class="s1-atr__fact"
        >
          <dt>
            Facility
          </dt>
          <dd>
            Kent Cannery
          </dd>
        </div>
        <div
          class="s1-atr__fact"
        >
          <dt>
            Period
          </dt>
          <dd>
            Sep 2025
          </dd>
        </div>
      </dl>
      <form
        class="s1-atr__form"
      >
        <div
          class="s1-atr__row"
        >
          <label
            class="s1-modal__field"
          >
            <span>
              Request type
            </span>
            <select>
              <option
                value="missing_document"
              >
                Missing document
              </option>
              <option
                value="replace_document"
              >
                Replace document
              </option>
              <option
                value="missing_data"
              >
                Missing data
              </option>
              <option
                value="clarify"
              >
                Clarify
              </option>
              <option
                value="confirm_or_restate"
              >
                Confirm or restate
              </option>
            </select>
          </label>
          <label
            class="s1-modal__field"
          >
            <span>
              Raised by
            </span>
            <select>
              <option
                value="mosei"
              >
                M. Osei
              </option>
              <option
                value="riqbal"
              >
                R. Iqbal
              </option>
              <option
                value="tbrandt"
              >
                T. Brandt
              </option>
              <option
                value="lchen"
              >
                L. Chen
              </option>
            </select>
          </label>
        </div>
        <label
          class="s1-modal__field"
        >
          <span>
            What is needed
          </span>
          <textarea
            rows="4"
          >
            kent_gas_sep_2025.pdf · Kent Cannery · Sep 2025: 
          </textarea>
        </label>
        <div
          class="s1-atr__foot"
        >
          <p
            class="s1-muted s1-modal__note"
          >
            Saved to Evidence requests as not yet sent. Nothing is emailed from here.
          </p>
          <div
            class="s1-modal__actions"
          >
            <button
              class="s1-button"
              type="button"
            >
              Cancel
            </button>
            <button
              class="s1-button s1-button--pri"
              type="submit"
            >
              Add to requests
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
`;
